{
  "schemaVersion": 1,
  "id": "ingamecnl",
  "version": "${version}",
  "name": "In-Game Console & Logging",
  "description": "An in-game logging viewer and command console with a adjustable overlay.",
  "authors": [
    "NoTuring_Steve"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/ingamecnl/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.nts.ingamecnl.fabric.InGameConsoleFabric"
    ],
    "modmenu": [
      "com.nts.ingamecnl.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "ingamecnl.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "architectury": ">=20.1.16",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_language_kotlin_version}",
    "cloth-config": ">=26.1.154"
  },
  "suggests": {
    "modmenu": ">=18.0.2"
  }
}
